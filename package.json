{
  "name": "root",
  "homepage": "https://github.com/raccoon-core/backstage-plugins",
  "repository": {
    "type": "git",
    "url": "https://github.com/raccoon-core/backstage-plugins.git"
  },
  "license": "Apache-2.0",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "build:all": "backstage-cli repo build --all",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "version": "changeset version && yarn install --no-immutable && (git commit -am 'Update internal dependencies' || true)",
    "release": "changeset publish",
    "prepare": "husky install",
    "postinstall": "husky install || true"
  },
  "workspaces": {
    "packages": [
      "plugins/**"
    ]
  },
  "dependencies": {
    "@changesets/cli": "^2.18.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.4",
    "@backstage/cli-defaults": "^0.1.4",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@spotify/prettier-config": "^12.0.0",
    "@types/jest": "^30.0.0",
    "husky": "^8.0.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^13.0.3",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
